rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Exported iCalendar files: {uid}/{semester}.ics
    // Public read so calendar apps can subscribe to the link.
    match /{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 1 * 1024 * 1024;
    }
  }
}
