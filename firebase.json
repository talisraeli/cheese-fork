{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      "*.local",
      "hosting-public",
      "predeploy.js"
    ],
    "predeploy": [
      "node functions/predeploy.js"
    ]
  },
  "hosting": {
    "public": "functions/hosting-public",
    "ignore": [
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      }
    ]
  }
}
