rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Saved schedules. Readable by anyone so that shared schedule links (?uid=) work.
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /semesters/{semester} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Course reviews. No longer used: the site links to the original CheeseFork's reviews instead.
    match /courseFeedback/{course} {
      allow read, write: if false;
    }

    // Course group links (WhatsApp, Telegram, Discord).
    match /courseExtraDetails/{course} {
      allow read, write: if request.auth != null;
    }

    // API keys (by hash) and each user's current key. Only the Cloud Functions access them.
    match /apiKeys/{hash} {
      allow read, write: if false;
    }
    match /apiKeyOwners/{uid} {
      allow read, write: if false;
    }

    // Reports on reviews. No longer used; existing reports can still be read in the console.
    match /courseFeedbackReports/{course} {
      allow read, write: if false;
    }
  }
}
