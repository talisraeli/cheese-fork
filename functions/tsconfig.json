{
    // The functions' sources in src/, compiled to build/, which Firebase deploys (see the
    // predeploy of firebase.json). The tests run the sources as they are, with Node's type
    // stripping, so the relative imports name the .ts files, and tsc rewrites them.
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "src",
        "outDir": "build",
        "strict": true,
        "isolatedModules": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "rewriteRelativeImportExtensions": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src"]
}
